# Modelo público sem valores da instalação. Preencha somente no ambiente local/Vercel.
# Nunca publique credenciais reais. Consulte README.md para configuração e propriedades.
# LIFEOS_ALLOWED_GOOGLE_EMAILS: exatamente duas contas, separadas por vírgula.
# LIFEOS_LEGACY_OWNER_EMAIL: uma das duas contas, definida como principal.
# LIFEOS_APP_URL: origem HTTPS da sua instalação, sem caminho adicional.
# LIFEOS_SESSION_SECRET: segredo aleatório com pelo menos 32 caracteres.

# Servidor, login e coordenação
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LIFEOS_APP_URL=
LIFEOS_SESSION_SECRET=
LIFEOS_ALLOWED_GOOGLE_EMAILS=
LIFEOS_LEGACY_OWNER_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: nomes por email em objeto JSON ou nomes na mesma ordem das contas autorizadas.
LIFEOS_ACCOUNT_NAMES=
# Opcional: titular fixa do ciclo; por padrão, a conta autorizada diferente da principal.
LIFEOS_CYCLE_OWNER_EMAIL=

# Bancos principais e áreas opcionais
NOTION_PROJECTS_DATABASE_ID=
NOTION_MILESTONES_DATABASE_ID=
NOTION_TASKS_DATABASE_ID=
NOTION_INBOX_DATABASE_ID=
NOTION_DIARY_DATABASE_ID=
NOTION_FINANCE_CATEGORIES_DATABASE_ID=
NOTION_FINANCE_TRANSACTIONS_DATABASE_ID=
NOTION_CONTACTS_DATABASE_ID=
NOTION_SHOPPING_DATABASE_ID=
NOTION_HABITS_DATABASE_ID=
NOTION_HABIT_LOGS_DATABASE_ID=
NOTION_MEDIA_SECTIONS_DATABASE_ID=
NOTION_MEDIA_DATABASE_ID=
NOTION_RECADOS_DATABASE_ID=
NOTION_WELLNESS_DATABASE_ID=
NOTION_CYCLE_DATABASE_ID=
NOTION_VEHICLES_DATABASE_ID=
NOTION_NUTRITION_DATABASE_ID=
NOTION_SOMEDAY_DATABASE_ID=
NOTION_REFERENCE_DATABASE_ID=

# Página de backup
NOTION_BACKUP_PAGE_ID=

# Fontes de dados explícitas: preencher apenas quando necessário
